{
  "name": "plainspeak",
  "version": "0.1.0",
  "description": "Always-on plain-English overlay for Slack and Gmail. Press a hotkey, see what they actually mean. Runs on your Claude subscription, no API keys.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test",
    "server": "bun run src/server.ts",
    "rules:check": "bun run src/cli.ts",
    "daemon:start": "bash daemon/start.sh",
    "daemon:stop": "bash daemon/stop.sh",
    "daemon:attach": "bash daemon/attach.sh",
    "daemon:status": "bash daemon/status.sh",
    "install:hammerspoon": "bash scripts/install-hammerspoon.sh",
    "install:launchd": "bash scripts/install-launchd.sh",
    "uninstall:launchd": "bash scripts/uninstall-launchd.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
